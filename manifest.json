{
  "manifest_version": 3,
  "name": "Traducteur de bulles",
  "version": "1.0.0",
  "description": "Lit le texte des bulles dans les images (OCR local Tesseract) et le traduit gratuitement, sans clé d'API.",
  "permissions": ["contextMenus", "offscreen", "storage", "activeTab", "scripting", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Traducteur de bulles",
    "default_popup": "popup.html"
  },
  "commands": {
    "translate-page": {
      "suggested_key": { "default": "Alt+T" },
      "description": "Traduire toutes les images de la page"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
